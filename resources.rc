// Resource script with updated transparent circular icon
#include <winver.h>

IDI_ICON1 ICON DISCARDABLE "app_icon.ico"

1 VERSIONINFO
    FILEVERSION 2,1,0,0
    PRODUCTVERSION 2,1,0,0
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "HEVC Video Shrinker"
            VALUE "FileVersion", "2.1"
            VALUE "InternalName", "hevc_shrinker"
            VALUE "OriginalFilename", "hevc_shrinker.exe"
            VALUE "ProductName", "HEVC Video Shrinker"
            VALUE "ProductVersion", "2.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
